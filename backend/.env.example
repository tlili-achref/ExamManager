# PostgreSQL
POSTGRES_USER=exammanager
POSTGRES_PASSWORD=exammanager_secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USER=exammanager
RABBITMQ_PASSWORD=exammanager_secret
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://exammanager:exammanager_secret@rabbitmq:5672/

# JWT
JWT_SECRET=change_me_super_secret_jwt_key_32chars_min
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# Service URLs (Docker Compose DNS)
AUTH_SERVICE_URL=http://auth-service:8001
EXAM_SERVICE_URL=http://exam-service:8002
ROOM_SERVICE_URL=http://room-service:8003
USER_SERVICE_URL=http://user-service:8004
GRADE_SERVICE_URL=http://grade-service:8005
NOTIFICATION_SERVICE_URL=http://notification-service:8006
SOAP_SERVICE_URL=http://soap-service:8007

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
